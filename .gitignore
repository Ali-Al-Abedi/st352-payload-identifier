# Editor / OS
.DS_Store
Thumbs.db
*~
.vscode/
.idea/

# Node / Python build crud (we shouldn't have any, but just in case)
node_modules/
__pycache__/
*.pyc

# Local-only debug files
/tmp/
*.log

# SMPTE source-of-truth PDFs are SMPTE-copyrighted and must NOT be
# committed to a public repo. They live in docs/smpte/ on engineers'
# local clones (downloaded individually from the SMPTE store) but are
# never tracked by git. Only docs/smpte/README.md is tracked.
docs/smpte/*
!docs/smpte/README.md

# Audit PDF-text extracts contain copyrighted SMPTE / ITU-R material;
# they are regenerated locally from docs/smpte/*.pdf via
# tests/extract_pdfs.sh. Audit findings (audit/findings/*.md) ARE
# committed because they only quote the minimum verbatim text
# necessary for the bit-level cross-check.
audit/pdf-text/*
!audit/pdf-text/README.md
